# ============================================================================
# Multi Therapy - Environment Configuration Template (.env.example)
# Use these environment variables when configuring your Vercel deployment:
# Project Settings > Environment Variables
# ============================================================================

# Flask Session & Security
SECRET_KEY=your_secret_key_here

# Email / OTP Delivery (Resend / SMTP)
EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_email_app_password
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Multi Therapy <onboarding@resend.dev>

# MySQL Database (TiDB Cloud / Local / Remote)
DB_HOST=your_db_host
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=cerebral_palsy_db
DB_PORT=4000
DB_SSL=true

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Frontend & Backend URLs
VERCEL_FRONTEND_URL=https://your-frontend.vercel.app
API_BASE_URL=https://cp-backend-t590.onrender.com

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
