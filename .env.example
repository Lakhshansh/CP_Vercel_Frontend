# Resend.com API Configuration
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email address
# Free accounts can use "onboarding@resend.dev" to test with their account email,
# or your custom domain email (e.g. "CP Healthcare <support@yourdomain.com>") once verified on Resend.
RESEND_FROM_EMAIL=CP Healthcare <onboarding@resend.dev>
